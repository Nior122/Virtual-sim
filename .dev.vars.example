# Copy to .dev.vars for local `wrangler pages dev` runs.
# .dev.vars is git-ignored. In production, set these as Pages secrets:
#   npx wrangler pages secret put TELEGRAM_BOT_TOKEN --project-name <project>

# From @BotFather
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Any random string; must match the secret_token used in setWebhook
TELEGRAM_WEBHOOK_SECRET="change-me-long-random-string"

# ---------------------------------------------------------------------------
# AI providers (OpenAI-compatible). NO model is hardcoded in the code: a
# provider is used only when BOTH its API key and its model ID are set here.
# ---------------------------------------------------------------------------

# Groq (https://console.groq.com/keys) — paste the model ID exactly as the
# provider lists it, e.g. from https://console.groq.com/docs/models
GROQ_API_KEY=""
GROQ_MODEL=""
# GROQ_BASE_URL=""            # optional endpoint override

# OpenRouter (https://openrouter.ai/keys) — used when Groq fails or is unset.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# OPENROUTER_BASE_URL=""      # optional endpoint override

# Any other OpenAI-compatible gateway (vLLM, LiteLLM, Together, …).
# OPENAI_API_KEY=""
# OPENAI_MODEL=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Aliases AI_API_KEY / AI_MODEL / AI_BASE_URL work the same way.

# Attempt order. Default: groq,openrouter,openai
# AI_PROVIDER_ORDER="openrouter,groq"

# Neon PostgreSQL connection string (Neon dashboard -> Connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require"

# The manager's Telegram handle guests are sent to. Optional: unset means the
# default in src/lib/manager.ts, which is the only place the handle lives.
# Accepts "KasiQueenbot", "@KasiQueenbot" or a full https://t.me/... URL.
# MANAGER_TELEGRAM="KasiQueenbot"

# Public URL of THIS Pages project (media + profile link host).
# Leave empty in local dev to fall back to the incoming request origin.
PUBLIC_BASE_URL=""
